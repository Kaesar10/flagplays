<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.flagplays.app"
    android:versionCode="9"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!-- Guardar en Descargas en API 24-28 (en API 29+ se usa MediaStore). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Retroalimentación háptica del puente AndroidBridge.vibrate(). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:enableOnBackInvokedCallback="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FlagPlays.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider propio (sin AndroidX): sirve ficheros del caché por content://
             para compartirlos con otras apps (AndroidBridge.shareFile). -->
        <provider
            android:name=".FlagPlaysProvider"
            android:authorities="com.flagplays.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
